# Keep source and documentation consistent across Windows and Unix checkouts.
* text=auto eol=lf

# Vendored assets are small enough for ordinary Git; no Git LFS dependency.
*.png binary
*.ico binary
*.ttf binary
*.zip binary

# Shown verbatim by the Windows installer's license page.
LICENSE-BINARY.txt text eol=crlf

# Gradle wrapper: cmd.exe needs CRLF batch files; the wrapper JAR is binary.
android/gradlew.bat text eol=crlf
*.jar binary
