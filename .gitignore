# Rust / Cargo build output (debug, release, and incremental artifacts).
# Cargo.lock stays tracked for application builds.
target/


# Local secret files (dotenv family). All environment-specific variants are
# ignored by default at any depth; public templates (.env.example,
# .env.<name>.example, .env.template) are explicitly re-included. A template
# must not contain real secrets.
.env
.env.*
!.env.example
!.env.*.example
!.env.template

# OS-generated local files.
Thumbs.db
Desktop.ini

# Local Python helpers and generated bytecode.
__pycache__/
*.pyc
